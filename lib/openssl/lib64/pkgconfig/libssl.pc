# This file provides configuration information for OpenSSL
prefix=/home/maxim-solodkov/tom/Solodkov/nlx-repo/3rdparty/openssl/install
exec_prefix=${prefix}
libdir=${exec_prefix}/lib64
includedir=${prefix}/include

Name: OpenSSL-libssl
Description: Secure Sockets Layer and cryptography libraries
Version: 4.2.0-dev
Requires.private: libcrypto
Libs: -L${libdir} -lssl
Cflags: -I${includedir}
